<Window x:Class="JASS.FileOrganizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JASS File Organizer Pro — Final"
        Width="1500" Height="900" MinWidth="1150" MinHeight="700" Background="#F4F6F8">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#18202A" Padding="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="JASS File Organizer Pro" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="File intelligence • search • duplicates • safe organization" Foreground="#B9C5D1"/></StackPanel>
                <TextBlock Grid.Column="1" Text="v2.1 Final" Foreground="#B9C5D1" VerticalAlignment="Center" Margin="20"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E9EDF1" Padding="8"><DockPanel><TextBlock Text="{Binding Status}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Stats}" Margin="20,0,0,0"/></DockPanel></Border>
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Grid.Row="0">
                <Button Content="📁 Select Folder" Click="SelectFolder_Click"/><Button Content="🔎 Scan" Click="Scan_Click"/>
                <Button Content="♻ Exact Duplicates" Click="Duplicates_Click"/><Button Content="🖼 Visual Similar" Click="VisualDuplicates_Click"/>
                <Button Content="📊 Dashboard" Click="Dashboard_Click"/><Button Content="✎ Batch Rename" Click="BatchRename_Click"/>
                <Button Content="🗂 Plan Organization" Click="PlanOrganization_Click"/><Button Content="▶ Apply Plan" Click="ApplyPlan_Click"/>
                <Button Content="📜 History" Click="History_Click"/><Button Content="⛔ Cancel" Click="Cancel_Click"/>
            </WrapPanel>
            <Grid Grid.Row="1" Margin="0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search filename or full path"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedType}" Margin="4"/>
                <TextBox Grid.Column="2" Text="{Binding MinSize, UpdateSourceTrigger=PropertyChanged}" ToolTip="Minimum size in MB"/><TextBox Grid.Column="3" Text="{Binding MaxSize, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum size in MB"/>
                <TextBox Grid.Column="4" Text="{Binding DaysOld, UpdateSourceTrigger=PropertyChanged}" ToolTip="Older than N days"/>
                <TextBlock Grid.Column="5" Text="{Binding SelectedFolder}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TabControl Grid.Row="2">
                <TabItem Header="Files">
                    <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                        <DataGrid x:Name="FilesGrid" ItemsSource="{Binding FilesView}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="FilesGrid_SelectionChanged" GridLinesVisibility="Horizontal" CanUserSortColumns="True">
                            <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="105"/><DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="85"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="105"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="145"/><DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/></DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" Margin="10,0,0,0" Background="White" BorderBrush="#D4DAE0" BorderThickness="1" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="INSPECTOR" FontSize="14" FontWeight="Bold"/><Image x:Name="PreviewImage" Height="220" Stretch="Uniform" Margin="0,12"/>
                            <TextBlock x:Name="InspectorName" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="InspectorInfo" Margin="0,8" TextWrapping="Wrap"/>
                            <Separator Margin="0,8"/><TextBlock Text="Actions" FontWeight="Bold"/><WrapPanel><Button Content="Open" Click="Open_Click"/><Button Content="Rename" Click="Rename_Click"/><Button Content="Copy Path" Click="CopyPath_Click"/><Button Content="Recycle" Click="Recycle_Click"/></WrapPanel>
                        </StackPanel></ScrollViewer></Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Exact Duplicates">
  <Grid Margin="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
    <ListView x:Name="DuplicateGroupsList" ItemsSource="{Binding DuplicateGroups}" SelectionChanged="DuplicateGroup_SelectionChanged">
      <ListView.View><GridView>
        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="110"/>
        <GridViewColumn Header="Files" DisplayMemberBinding="{Binding CountText}" Width="110"/>
        <GridViewColumn Header="Reclaimable" DisplayMemberBinding="{Binding ReclaimableText}" Width="130"/>
        <GridViewColumn Header="SHA-256" DisplayMemberBinding="{Binding Hash}" Width="520"/>
      </GridView></ListView.View>
    </ListView>
    <Border Grid.Column="1" Margin="10,0,0,0" Padding="12" Background="White" BorderBrush="#D4DAE0" BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Open Location" Click="OpenDuplicateLocation_Click"/>
            <Button Content="Recycle Selected" Click="RecycleDuplicateSelected_Click"/>
            <Button Content="Keep Selected • Recycle Others" Click="KeepDuplicateSelected_Click"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="DUPLICATE GROUP" FontSize="14" FontWeight="Bold"/>
          <TextBlock x:Name="DuplicateGroupInfo" Margin="0,6,0,10" TextWrapping="Wrap" Text="Select a duplicate group to inspect its files."/>
          <TextBlock Text="Files in this group — select one to keep or select several to recycle:" FontWeight="Bold" TextWrapping="Wrap"/>
          <ListBox x:Name="DuplicateFilesList" ItemsSource="{Binding SelectedDuplicateFiles}" SelectionMode="Extended" SelectionChanged="DuplicateFile_SelectionChanged" Margin="0,6" MinHeight="250"/>
          <TextBlock x:Name="DuplicateSelectedPath" Text="No file selected" TextWrapping="Wrap" Foreground="#5B6570"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</TabItem>
                <TabItem Header="Visual Similar">
    <Grid Margin="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ListView x:Name="VisualGroupsList" Grid.Column="0" ItemsSource="{Binding VisualDuplicateGroups}" SelectionChanged="VisualGroups_SelectionChanged">
            <ListView.View><GridView>
                <GridViewColumn Header="Group" DisplayMemberBinding="{Binding CountText}" Width="220"/>
                <GridViewColumn Header="Similarity" DisplayMemberBinding="{Binding SimilarityText}" Width="110"/>
                <GridViewColumn Header="Signature" DisplayMemberBinding="{Binding Signature}" Width="200"/>
            </GridView></ListView.View>
        </ListView>
        <Border Grid.Column="1" Margin="10,0,0,0" Background="White" BorderBrush="#D4DAE0" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="VISUAL SIMILAR GROUP" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="VisualGroupInfo" Margin="0,6,0,10" TextWrapping="Wrap"/>
                <Image x:Name="VisualPreview" Height="230" Stretch="Uniform" Margin="0,0,0,10"/>
                <TextBlock Text="Files in this group" FontWeight="Bold"/>
                <ListBox x:Name="VisualFilesList" Height="220" SelectionChanged="VisualFiles_SelectionChanged" DisplayMemberPath="."/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Open Location" Click="VisualOpenLocation_Click"/>
                    <Button Content="Open Selected" Click="VisualOpenSelected_Click"/>
                </WrapPanel>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</TabItem>
                <TabItem Header="Organization Plan"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Proposed moves are preview-only until Apply Plan is pressed." Margin="4"/><DataGrid Grid.Row="1" ItemsSource="{Binding OrganizationPlan}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="160"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
                <TabItem Header="History"><ListView Margin="8" ItemsSource="{Binding History}"><ListView.View><GridView><GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="150"/><GridViewColumn Header="Operation" DisplayMemberBinding="{Binding Operation}" Width="140"/><GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="400"/><GridViewColumn Header="Destination" DisplayMemberBinding="{Binding Destination}" Width="400"/></GridView></ListView.View></ListView></TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
